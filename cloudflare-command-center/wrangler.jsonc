{
  "name": "superior-command-center",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "BACKUP_EMAIL": "superiormandr@gmail.com",
    "GOOGLE_DRIVE_BACKUP_FOLDER_ID": "1yaMI4U93EE9LaPkVuEVYkUzgaE8afHDp"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "superior-command-center",
      "database_id": "4feb6f63-1102-467a-87e6-256309364f12",
      "migrations_dir": "migrations"
    }
  ]
}
